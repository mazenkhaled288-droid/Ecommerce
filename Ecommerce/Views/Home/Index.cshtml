<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To-Do List Application</title>
    <style>
            * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
            body { background-color: #f4f7fe; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; }
            .card { background: #ffffff; width: 100%; max-width: 700px; padding: 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); text-align: center; }
            .hidden { display: none !important; }
            h2 { margin-bottom: 15px; color: #2b3674; }
            input, textarea { width: 100%; padding: 12px; margin: 10px 0; border: 1px solid #e0e5f2; border-radius: 8px; outline: none; }
            button { background-color: #4318ff; color: white; border: none; padding: 12px 24px; border-radius: 8px; cursor: pointer; font-weight: bold; transition: 0.2s; margin-top: 10px; }
            button:hover { background-color: #3311db; }
            .btn-danger { background-color: #ee5d50; margin-right: 5px; }
            .btn-danger:hover { background-color: #e31a1a; }
            .btn-warning { background-color: #ffb547; color: #000; }
            .btn-warning:hover { background-color: #e59d29; }
            table { width: 100%; border-collapse: collapse; margin-top: 20px; text-align: right; }
            th, td { padding: 12px; border-bottom: 1px solid #e0e5f2; }
            th { background-color: #f7f9fc; color: #a3ed00; color: #475569; }
            .form-container { text-align: right; background: #f8fafc; padding: 15px; border-radius: 8px; margin-bottom: 20px; }
    </style>
</head>
<body>

    <div class="card">
        <div id="step-1">
            <h2>مرحباً بك في تطبيق إدارة المهام</h2>
            <p style="color: #a3edd0; color: #64748b; margin-bottom: 20px;">قم بإدارة مواعيدك ومهامك اليومية بكل سهولة</p>
            <button onclick="goToStep(2)">Create</button>
        </div>

        <div id="step-2" class="hidden">
            <h2>أدخل اسمك للبدء</h2>
            <input type="text" id="userNameInput" placeholder="اكتب اسمك هنا...">
            <button onclick="saveName()">متابعة</button>
        </div>

        <div id="step-3" class="hidden">
            <h2 id="welcomeHeader">أهلاً بك</h2>

            <button onclick="toggleForm()" id="toggleFormBtn">+ Create New Task</button>

            <div id="taskForm" class="form-container hidden">
                <h3 id="formTitle" style="margin-bottom: 10px;">إضافة مهمة جديدة</h3>
                <input type="hidden" id="editIndex">
                <input type="text" id="taskTitle" placeholder="Title (عنوان المهمة)">
                <textarea id="taskDesc" placeholder="Description (الوصف)" rows="3"></textarea>
                <input type="datetime-local" id="taskDeadline">
                <button onclick="saveTask()">حفظ المهمة</button>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Deadline</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="tasksTableBody">
                </tbody>
            </table>
        </div>
    </div>

    <script>
            let tasks = [];

            function goToStep(stepNumber) {
                document.getElementById('step-1').classList.add('hidden');
                document.getElementById('step-2').classList.add('hidden');
                document.getElementById('step-3').classList.add('hidden');
                document.getElementById(`step-${stepNumber}`).classList.remove('hidden');
            }

            function saveName() {
                const name = document.getElementById('userNameInput').value.trim();
                if (!name) return alert('برجاء كتابة الاسم أولاً');
                document.getElementById('welcomeHeader').innerText = `قائمة مهام: ${name}`;
                goToStep(3);
            }

            function toggleForm() {
                const form = document.getElementById('taskForm');
                form.classList.toggle('hidden');
                if (!form.classList.contains('hidden')) {
                    resetForm();
                }
            }

            function resetForm() {
                document.getElementById('editIndex').value = '';
                document.getElementById('taskTitle').value = '';
                document.getElementById('taskDesc').value = '';
                document.getElementById('taskDeadline').value = '';
                document.getElementById('formTitle').innerText = 'إضافة مهمة جديدة';
            }

            function saveTask() {
                const title = document.getElementById('taskTitle').value.trim();
                const desc = document.getElementById('taskDesc').value.trim();
                const deadline = document.getElementById('taskDeadline').value;
                const editIndex = document.getElementById('editIndex').value;

                if (!title || !deadline) return alert('برجاء إدخال العنوان والموعد النهائي');

                const taskData = { title, desc, deadline };

                if (editIndex === '') {
                    tasks.push(taskData);
                } else {
                    tasks[editIndex] = taskData;
                }

                resetForm();
                document.getElementById('taskForm').classList.add('hidden');
                renderTasks();
            }

            function renderTasks() {
                const tbody = document.getElementById('tasksTableBody');
                tbody.innerHTML = '';

                tasks.forEach((task, index) => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${task.title}</td>
                        <td>${task.desc || '-'}</td>
                        <td>${new Date(task.deadline).toLocaleString('ar-EG')}</td>
                        <td>
                            <button class="btn-warning" onclick="editTask(${index})">تعديل</button>
                            <button class="btn-danger" onclick="deleteTask(${index})">حذف</button>
                        </td>
                    `;
                    tbody.appendChild(row);
                });
            }

            function editTask(index) {
                const task = tasks[index];
                document.getElementById('editIndex').value = index;
                document.getElementById('taskTitle').value = task.title;
                document.getElementById('taskDesc').value = task.desc;
                document.getElementById('taskDeadline').value = task.deadline;
                document.getElementById('formTitle').innerText = 'تعديل المهمة';
                document.getElementById('taskForm').classList.remove('hidden');
            }

            function deleteTask(index) {
                if (confirm('Are You Sure')) {
                    tasks.splice(index, 1);
                    renderTasks();
                }
            }
    </script>
</body>
</html>