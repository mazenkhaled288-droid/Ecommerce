@model Category
<div class="container-fluid px-4">
    <h1 class="mt-4">Update Category</h1>

    <form asp-action="Create" method="post">

       
        <div class="mb-3">
            <label class="form-label">Category Name</label>
            <input name="Name" class="form-control"value="@Model.Name" placeholder="Enter category name..." />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="Description" class="form-control" rows="3" placeholder="Enter description...">@Model.Description</textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="States" class="form-select">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>

    
        <button type="submit" class="btn btn-primary">Save</button>

    </form>
</div>
