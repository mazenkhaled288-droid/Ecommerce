@model CategoryitemWithRelatedVM
<div class="container-fluid px-4">
    <h1 class="mt-4">Category List</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Admin/Home/Index">Dashboard</a></li>
        <li class="breadcrumb-item active">Categories</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <form asp-controller="Category" asp-action="Index" method="get" class="d-flex">
                <input type="text" name="name"value="@Model.Name" class="form-control form-control-sm me-2" placeholder="Search category..." />
                <button type="submit" class="btn btn-outline-primary btn-sm">Search</button>
            </form>
            <div>
                <i class="fas fa-table me-1"></i>
                All Categories
            </div>
            
            <a asp-controller="Category" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Create New Category
            </a>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Status</th>  
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model.Categories)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.States </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-controller="Category" asp-action="Update" asp-route-id="@item.ID" class="btn btn-primary btn-sm mx-1">
                                        Edit
                                    </a>
                                    <a asp-controller="Category" asp-action="Delete" asp-route-id="@item.ID" class="btn btn-danger btn-sm mx-1">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    <div class="d-flex justify-content-center mt-3">
                        <nav aria-label="Page navigation">
                            <ul class="pagination">

                                
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, name = Model.Name })">«</a>
                                </li>

                               
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, name = Model.Name })" style="cursor: pointer;">@i</a>
                                    </li>
                                }

                               
                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, name = Model.Name })">»</a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                </tbody>
            </table>
        </div>
    </div>
</div>
